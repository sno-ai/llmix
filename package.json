{
  "name": "@snoai/llmix",
  "version": "2.0.0",
  "description": "Config-driven harness around your LLM SDK. YAML-driven model swap, two-tier cache, circuit breaker, key-pool rotation. TypeScript and Python parity.",
  "author": "Sno AI",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sno-ai/llmix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sno-ai/llmix.git"
  },
  "bugs": {
    "url": "https://github.com/sno-ai/llmix/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./typescript/dist/index.js",
  "types": "./typescript/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./typescript/dist/index.d.ts",
      "import": "./typescript/dist/index.js"
    },
    "./pricing": {
      "types": "./typescript/dist/pricing/index.d.ts",
      "import": "./typescript/dist/pricing/index.js"
    }
  },
  "files": [
    "typescript/dist",
    "typescript/src",
    "data"
  ],
  "scripts": {
    "build": "bun run tsc",
    "dev": "bun run tsc --watch",
    "check": "bunx tsc -p tsconfig.check.json",
    "clean": "rm -rf typescript/dist",
    "test": "bun test",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.12.21",
    "lru-cache": "^11.3.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": ">=3.0.0",
    "@ai-sdk/google": ">=3.0.0",
    "@ai-sdk/openai": ">=3.0.0",
    "@anthropic-ai/sdk": ">=0.80.0",
    "ai": ">=6.0.0",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.66",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@anthropic-ai/sdk": "^0.92.0",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "ai": "^6.0.0",
    "ioredis": "^5.4.1",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "llm",
    "ai",
    "config",
    "openai",
    "anthropic",
    "google",
    "deepseek",
    "cache",
    "redis",
    "lru"
  ]
}
